{
  "$id": "dmf://schemas/rights_decision/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capability": {
      "type": "string"
    },
    "checked_at": {
      "format": "date-time",
      "type": "string"
    },
    "decision": {
      "enum": [
        "ALLOW",
        "DENY"
      ]
    },
    "profile_id": {
      "type": "string"
    },
    "profile_version": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "profile_id",
    "profile_version",
    "capability",
    "decision",
    "reason"
  ],
  "type": "object"
}
