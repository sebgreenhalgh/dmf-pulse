{
  "$defs": {
    "ResultStatus": {
      "enum": [
        "COMPLETE",
        "BLOCKED",
        "FAILED"
      ],
      "title": "ResultStatus",
      "type": "string"
    },
    "ReviewFile": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "purpose": {
          "title": "Purpose",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "name",
        "sha256",
        "bytes",
        "purpose"
      ],
      "title": "ReviewFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "ticket_id": {
            "const": "RUL-002"
          }
        },
        "required": [
          "ticket_id"
        ]
      },
      "then": {
        "properties": {
          "archive_sha256": {
            "type": "null"
          },
          "baseline": {
            "const": "12049a7de23a4a8fcca3d219dbcab1bf5e1027ea"
          },
          "file_count": {
            "const": 20
          }
        },
        "required": [
          "baseline",
          "payload_sha256"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "ticket_id": {
            "const": "DAT-003"
          }
        },
        "required": [
          "ticket_id"
        ]
      },
      "then": {
        "properties": {
          "archive_sha256": {
            "type": "null"
          },
          "baseline": {
            "const": "f9b51e965aad1bc94796c17c897f0d99b4c16e1b"
          },
          "file_count": {
            "const": 20
          },
          "files": {
            "maxItems": 18,
            "minItems": 18
          }
        },
        "required": [
          "baseline",
          "payload_sha256"
        ]
      }
    }
  ],
  "properties": {
    "acceptance_status": {
      "$ref": "#/$defs/ResultStatus"
    },
    "archive_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Archive Sha256"
    },
    "baseline": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Baseline"
    },
    "file_count": {
      "maximum": 20,
      "minimum": 1,
      "title": "File Count",
      "type": "integer"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/ReviewFile"
      },
      "maxItems": 20,
      "title": "Files",
      "type": "array"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "payload_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Payload Sha256"
    },
    "repository_head": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Repository Head",
      "type": "string"
    },
    "ticket_id": {
      "maxLength": 40,
      "minLength": 3,
      "pattern": "^[A-Z0-9]+(?:[-.][A-Z0-9]+)*$",
      "title": "Ticket Id",
      "type": "string"
    }
  },
  "required": [
    "ticket_id",
    "generated_at",
    "repository_head",
    "file_count",
    "files",
    "acceptance_status"
  ],
  "title": "ReviewManifest",
  "type": "object"
}
