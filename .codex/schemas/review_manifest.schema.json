{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DMF Pulse Review Pack Manifest",
  "type": "object",
  "required": [
    "ticket_id",
    "generated_at",
    "repository_head",
    "file_count",
    "files",
    "acceptance_status"
  ],
  "properties": {
    "ticket_id": {
      "const": "FND-001"
    },
    "generated_at": {
      "type": "string"
    },
    "repository_head": {
      "type": "string"
    },
    "baseline": {
      "type": "string"
    },
    "file_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "acceptance_status": {
      "enum": [
        "COMPLETE",
        "BLOCKED",
        "FAILED"
      ]
    },
    "files": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "name",
          "sha256",
          "bytes",
          "purpose"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer"
          },
          "purpose": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
